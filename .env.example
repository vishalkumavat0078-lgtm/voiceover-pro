# ======================================================
# ELEVENLABS SESSION (API KEY KI ZAROORAT NAHI!)
# ======================================================

# Step 1: ElevenLabs.io pe login karo (apna account)
# Step 2: Browser mein F12 dabao → Network tab
# Step 3: ElevenLabs pe koi bhi voice generate karo
# Step 4: Network mein "text-to-speech" request dhundo
# Step 5: Request Headers mein se copy karo:

# xi-api-key header ki value (yeh aapka user auth token hai)
EL_SESSION_TOKEN=your_elevenlabs_session_token_here

# Puri Cookie header copy karo (optional, zyada stable hota hai)
# EL_COOKIE=__cf_bm=xxx; _ga=xxx; ...

# ======================================================
# DATABASE
# ======================================================
MONGODB_URI=your_mongodb_connection_string_here

# ======================================================
# SERVER CONFIG  
# ======================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string
PORT=3000

# ======================================================
# ADMIN ACCOUNT
# ======================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
